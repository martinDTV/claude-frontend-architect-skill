{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "bundler", "strict": true, "baseUrl": ".",
    "paths": { "~/*": ["./app/*"], "@/*": ["./app/*"], "~~/*": ["./*"], "@@/*": ["./*"], "#shared/*": ["./shared/*"] }
  },
  "include": ["app", "server", "shared", "layers"]
}
