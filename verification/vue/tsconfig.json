{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "bundler", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true, "noUncheckedIndexedAccess": true, "noImplicitOverride": true, "verbatimModuleSyntax": true,
    "jsx": "react-jsx", "skipLibCheck": true, "noEmit": true, "isolatedModules": true,
    "baseUrl": ".", "paths": { "@/*": ["src/*"] }, "types": []
  },
  "include": ["src"]
}
